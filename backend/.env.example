# --- external recognizer (Tier 2) ---
# AudD token from https://dashboard.audd.io . Empty = AudD's small anonymous quota.
AUDD_API_TOKEN=
# 1 = fake the AudD path from a recorded fixture (demo without a token / without network)
MOCK_EXTERNAL=0

# --- features ---
AUTO_LEARN=1
FEATURE_LYRICS=1
# optional comparison view: needs the `fpcalc` binary (Chromaprint) and a key from https://acoustid.org
FEATURE_ACOUSTID=0
ACOUSTID_API_KEY=

# --- service ---
# MusicBrainz and LRCLIB require a descriptive User-Agent with contact info: put YOUR url/email here
BLAZAM_USER_AGENT=Blazam/0.1.0 ( https://github.com/your-name/blazam )
CORS_ORIGINS=http://localhost:3000
# optional: also allow origins matching a regex (Vercel preview deploys get a new URL each time)
# CORS_ORIGIN_REGEX=https://blazam-[a-z0-9-]+\.vercel\.app
# BLAZAM_DATA_DIR=./data
# BLAZAM_DB_PATH=./data/blazam.sqlite3
